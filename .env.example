# ==============================================================================
# Application Configuration
# ==============================================================================
PROJECT_NAME="RAG-Powered Knowledge Base API"
VERSION="1.0.0"
DEBUG=True
API_V1_PREFIX="/api/v1"
HOST="0.0.0.0"
PORT=8000

# ==============================================================================
# Redis Configuration (Chat History Memory)
# ==============================================================================
REDIS_URL="redis://localhost:6379/0"
REDIS_TTL_SECONDS=86400  # 24 hours retention for session memory

# ==============================================================================
# ChromaDB Configuration (Vector Store)
# ==============================================================================
CHROMA_PERSIST_DIR="./data/chroma_db"
CHROMA_COLLECTION_NAME="knowledge_base"

# ==============================================================================
# Hugging Face Configuration (Local Embeddings)
# ==============================================================================
# Default model: lightweight, fast, 384-dimensional embeddings
EMBEDDING_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_DEVICE="cpu"  # Options: "cpu", "cuda"

# ==============================================================================
# OpenAI API Configuration (LLM & Agent Reasoning)
# ==============================================================================
OPENAI_API_KEY="your-openai-api-key-here"
LLM_MODEL_NAME="gpt-4o-mini"
LLM_TEMPERATURE=0.0

